const triplo = (numero) => {return numero * 3};
console.log (triplo(5));

const calcularMedia = (nota1, nota2) => {return (nota1 + nota2) / 2};
console.log(calcularMedia(5,7));

const vPar = numero => numero %2 === 0;
console.log(vPar(5));

const convCel = ferh => (ferh - 32) * 5 / 9;
console.log(convCel(32));

const somMaUm = numero => numero + 1;
console.log(somMaUm(3));

const subt = (a, b) => a - b;
console.log(subt(1,2));
